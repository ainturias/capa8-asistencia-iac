{
 "uid": "capa8-tenants",
 "title": "Capa 8 · Salud de tenants",
 "tags": [
  "capa8"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Disponibilidad de la web (por tenant)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"probes\",instance=~\".*/$\",tenant=~\"$tenant\",env=~\"$env\"}",
     "legendFormat": "{{tenant}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CAÍDO",
         "color": "red"
        },
        "1": {
         "text": "EN LÍNEA",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "text": {
     "titleSize": 15,
     "valueSize": 26
    }
   },
   "description": "RF-26: disponibilidad. Sondeo HTTP a la URL del tenant."
  },
  {
   "id": 2,
   "title": "Disponibilidad de la API / backend",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"probes\",instance=~\".*/api/health\",tenant=~\"$tenant\",env=~\"$env\"}",
     "legendFormat": "{{tenant}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CAÍDO",
         "color": "red"
        },
        "1": {
         "text": "EN LÍNEA",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "text": {
     "titleSize": 15,
     "valueSize": 26
    }
   }
  },
  {
   "id": 3,
   "title": "Estado de la base de datos (VM db)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"tenants\",role=\"db\",tenant=~\"$tenant\",env=~\"$env\"}",
     "legendFormat": "{{tenant}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "CAÍDO",
         "color": "red"
        },
        "1": {
         "text": "EN LÍNEA",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "text": {
     "titleSize": 15,
     "valueSize": 26
    }
   },
   "description": "RF-26: estado de la BD (la VM de BD responde y reporta)."
  },
  {
   "id": 4,
   "title": "Alertas activas",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "title": "Alertas y eventos recientes (tenant afectado)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(ALERTS_FOR_STATE{tenant=~\"$tenant\"} and ignoring(alertstate) ALERTS{alertstate=\"firing\"}) * 1000",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Hora de detección"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsLocal"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "description": "RF-29: alertas activas con el tenant afectado y la hora en que Prometheus las detectó (cuando empezó la condición).",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "env": true,
       "plan": true
      },
      "renameByName": {
       "alertname": "Alerta",
       "tenant": "Tenant afectado",
       "role": "Rol",
       "severity": "Severidad",
       "instance": "Instancia",
       "Value": "Hora de detección"
      },
      "indexByName": {}
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Hora de detección"
       }
      ]
     }
    }
   ]
  },
  {
   "id": 6,
   "title": "CPU (%) por VM",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - avg by (tenant, role) (rate(node_cpu_seconds_total{mode=\"idle\",job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"}[2m])) * 100",
     "legendFormat": "{{tenant}} · {{role}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Memoria usada (%) por VM",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(1 - node_memory_MemAvailable_bytes{job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"} / node_memory_MemTotal_bytes{job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"}) * 100",
     "legendFormat": "{{tenant}} · {{role}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Latencia (s) web y API",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_duration_seconds{job=\"probes\",tenant=~\"$tenant\",env=~\"$env\"}",
     "legendFormat": "{{tenant}} · {{instance}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "RF-26: latencia medida por blackbox_exporter."
  },
  {
   "id": 9,
   "title": "Errores del backend (código HTTP ≥ 500)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_http_status_code{job=\"probes\",instance=~\".*/api/health\",tenant=~\"$tenant\",env=~\"$env\"} >= 500 or (1 - probe_success{job=\"probes\",instance=~\".*/api/health\",tenant=~\"$tenant\",env=~\"$env\"})",
     "legendFormat": "{{tenant}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Vale 1 cuando la API devuelve error o no responde."
  },
  {
   "id": 10,
   "title": "Disco usado (%) por VM",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\",job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\",job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"}) * 100",
     "legendFormat": "{{tenant}} · {{role}}",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Máquinas monitoreadas (up por VM)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"tenants\",tenant=~\"$tenant\",env=~\"$env\"}",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Estado"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "CAÍDO",
            "color": "red",
            "index": 0
           },
           "1": {
            "text": "EN LÍNEA",
            "color": "green",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "plan": true,
       "env": true
      },
      "renameByName": {
       "tenant": "Tenant",
       "role": "Rol",
       "plan": "Plan",
       "env": "Entorno",
       "instance": "Instancia",
       "Value": "Estado"
      },
      "indexByName": {
       "tenant": 0,
       "role": 1,
       "instance": 2,
       "Value": 3
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Tenant"
       }
      ]
     }
    }
   ]
  }
 ],
 "templating": {
  "list": [
   {
    "name": "tenant",
    "label": "Tenant",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"tenants\"}, tenant)",
     "refId": "v"
    },
    "definition": "label_values(up{job=\"tenants\"}, tenant)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "env",
    "label": "Entorno",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"tenants\"}, env)",
     "refId": "v"
    },
    "definition": "label_values(up{job=\"tenants\"}, env)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 }
}