HOST=127.0.0.1
PORT=4300
PLATFORM_DATABASE_URL=postgresql://asistencia_platform:CAMBIAR_PASSWORD_DB@127.0.0.1:5432/asistencia_platform
PLATFORM_ADMIN_NAME=Operador
PLATFORM_ADMIN_EMAIL=operador@example.com
PLATFORM_ADMIN_PASSWORD=

# URL pública de asistencia. Separa varias instalaciones con comas.
PLATFORM_TENANT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En desarrollo, permite copiar el enlace de invitación desde el panel.
PLATFORM_MAIL_TRANSPORT=preview

# Para correo real, configura el remitente y el servicio SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURE=false

# En producción, usar HTTPS en el proxy y en las instalaciones vinculadas.
# NODE_ENV=production

# --- Aprovisionamiento de tenants (runner) ---
# El backend ejecuta infra/scripts/tenant.sh en segundo plano. Necesita en el servidor: tofu/terraform, ansible, aws (credenciales
# en ~/.aws o variables AWS_*), la frase TF_ENCRYPTION en ~/.config/capa8/tf_encryption.env y los artefactos de la app
# (infra/ansible/build-artifacts.sh). Los procesos hijos solo reciben una lista blanca de variables (nunca PLATFORM_*).
# PROVISIONER_ENABLED=true
# PROVISIONER_AMI_ID=ami-xxxxxxxx        # AMI creada con Packer (infra/packer)
# PROVISIONER_REGION=us-east-2           # la AMI es de una sola región
# PROVISIONER_CONCURRENCY=2              # trabajos en paralelo
# PLATFORM_GRAFANA_URL=http://IP:3000    # enlace "Grafana" de cada institución
